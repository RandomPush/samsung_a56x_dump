on early-init
    mkdir /mnt/vendor/efs 0771 radio system
    mkdir /mnt/vendor/cpefs 0771 radio system
    mkdir /mnt/vendor/persist 0771 system system
    mount debugfs /sys/kernel/debug /sys/kernel/debug

    start watchdogd

    # load cp_security_app.cpk
    write /sys/devices/virtual/misc/custos_iwc/loader 1

    #insmod system related modules
    start insmod_sh_system
    start insmod_sh_common
    start insmod_sh_bluetooth

on init
    # See storage config details at http://source.android.com/tech/storage/
    mkdir /storage/sdcard 0000 root root
    mkdir /storage/usb1 0000 root root
    mkdir /storage/usb2 0000 root root
    mkdir /mnt/media_rw/sdcard 0700 media_rw media_rw
    mkdir /mnt/media_rw/usb1 0700 media_rw media_rw
    mkdir /mnt/media_rw/usb2 0700 media_rw media_rw

    export SECONDARY_STORAGE /storage/sdcard:/storage/usb1:/storage/usb2

   # Change suspend poewr mode to s2idle
    write /sys/power/mem_sleep s2idle

    # Support legacy paths
    symlink /storage/sdcard /mnt/ext_sd
    symlink /data/app /factory

    symlink /dev/block/by-name/param /dev/block/param

    # STEADY
    symlink /dev/block/by-name/steady /dev/block/steady

    # SEC RELOC GPIO
    chown root system /sys/class/sec/gpio/check_requested_gpio
    chmod 0664 /sys/class/sec/gpio/check_requested_gpio

    ## SCSC BT
    chown wifi wifi /vendor/bin/configcmd.sh
    chown wifi wifi /vendor/bin/android_configcmd

    # Change CPUIdle governor to HALO
    write /sys/devices/system/cpu/cpuidle/current_governor halo

    # Uclamp.min configuration
    write /dev/cpuctl/top-app/cpu.uclamp.min 1

    # Clear sched_util_clamp_min_rt_default
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0

    # EMS interfaces
    chown system system /dev/ems
    chown system system /sys/kernel/ems/emstune/req_mode
    chown system system /sys/kernel/ems/emstune/req_level
    chown system system /sys/kernel/ems/emstune/aio_tuner
    chown system system /sys/kernel/ems/emstune/reset
    chown system system /sys/kernel/ems/emstune/sched_boost
    chown system system /sys/kernel/ems/emstune/task_boost
    chown system system /sys/kernel/ems/emstune/task_boost_del
    chown system system /sys/kernel/ems/ego/coregroup0/ratio
    chown system system /sys/kernel/ems/ego/coregroup4/ratio
    chown system system /sys/kernel/ems/ego/coregroup7/ratio
    chown system system /sys/kernel/ems/ego/coregroup9/ratio

    # System Performance Lab - Vendor Taskgroup Permission ++
    # vendor taskgroup
    chown root system /sys/kernel/ems/taskgroup/background/proc
    chown root system /sys/kernel/ems/taskgroup/background/task
    chown root system /sys/kernel/ems/taskgroup/background/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/background/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/camera-daemon/proc
    chown root system /sys/kernel/ems/taskgroup/camera-daemon/task
    chown root system /sys/kernel/ems/taskgroup/camera-daemon/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/camera-daemon/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/dex2oat/proc
    chown root system /sys/kernel/ems/taskgroup/dex2oat/task
    chown root system /sys/kernel/ems/taskgroup/dex2oat/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/dex2oat/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/foreground/proc
    chown root system /sys/kernel/ems/taskgroup/foreground/task
    chown root system /sys/kernel/ems/taskgroup/foreground/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/foreground/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/midground/proc
    chown root system /sys/kernel/ems/taskgroup/midground/task
    chown root system /sys/kernel/ems/taskgroup/midground/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/midground/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/nnapi-hal/proc
    chown root system /sys/kernel/ems/taskgroup/nnapi-hal/task
    chown root system /sys/kernel/ems/taskgroup/nnapi-hal/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/nnapi-hal/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/rt/proc
    chown root system /sys/kernel/ems/taskgroup/rt/task
    chown root system /sys/kernel/ems/taskgroup/rt/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/rt/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/system/proc
    chown root system /sys/kernel/ems/taskgroup/system/task
    chown root system /sys/kernel/ems/taskgroup/system/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/system/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/system-background/proc
    chown root system /sys/kernel/ems/taskgroup/system-background/task
    chown root system /sys/kernel/ems/taskgroup/system-background/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/system-background/uclamp_min
    chown root system /sys/kernel/ems/taskgroup/top-app/proc
    chown root system /sys/kernel/ems/taskgroup/top-app/task
    chown root system /sys/kernel/ems/taskgroup/top-app/uclamp_max
    chown root system /sys/kernel/ems/taskgroup/top-app/uclamp_min

    chmod 0664 /sys/kernel/ems/taskgroup/background/proc
    chmod 0664 /sys/kernel/ems/taskgroup/background/task
    chmod 0664 /sys/kernel/ems/taskgroup/background/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/background/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/camera-daemon/proc
    chmod 0664 /sys/kernel/ems/taskgroup/camera-daemon/task
    chmod 0664 /sys/kernel/ems/taskgroup/camera-daemon/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/camera-daemon/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/dex2oat/proc
    chmod 0664 /sys/kernel/ems/taskgroup/dex2oat/task
    chmod 0664 /sys/kernel/ems/taskgroup/dex2oat/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/dex2oat/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/foreground/proc
    chmod 0664 /sys/kernel/ems/taskgroup/foreground/task
    chmod 0664 /sys/kernel/ems/taskgroup/foreground/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/foreground/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/midground/proc
    chmod 0664 /sys/kernel/ems/taskgroup/midground/task
    chmod 0664 /sys/kernel/ems/taskgroup/midground/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/midground/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/nnapi-hal/proc
    chmod 0664 /sys/kernel/ems/taskgroup/nnapi-hal/task
    chmod 0664 /sys/kernel/ems/taskgroup/nnapi-hal/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/nnapi-hal/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/rt/proc
    chmod 0664 /sys/kernel/ems/taskgroup/rt/task
    chmod 0664 /sys/kernel/ems/taskgroup/rt/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/rt/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/system/proc
    chmod 0664 /sys/kernel/ems/taskgroup/system/task
    chmod 0664 /sys/kernel/ems/taskgroup/system/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/system/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/system-background/proc
    chmod 0664 /sys/kernel/ems/taskgroup/system-background/task
    chmod 0664 /sys/kernel/ems/taskgroup/system-background/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/system-background/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/top-app/proc
    chmod 0664 /sys/kernel/ems/taskgroup/top-app/task
    chmod 0664 /sys/kernel/ems/taskgroup/top-app/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/top-app/uclamp_min

    # Uclamp.min configuration
    write /sys/kernel/ems/taskgroup/top-app/uclamp_min 1
    chown root system /sys/kernel/ems/taskgroup/top-app/uclamp_min
    chmod 0664 /sys/kernel/ems/taskgroup/top-app/uclamp_min
    write /sys/kernel/ems/taskgroup/midground/uclamp_max 20
    chown root system /sys/kernel/ems/taskgroup/midground/uclamp_max
    chmod 0664 /sys/kernel/ems/taskgroup/midground/uclamp_max
    # System Performance Lab - Vendor Taskgroup Permission --

    chown system system /dev/cpuset/tasks
    chown system system /dev/cpuset/cgroup.procs
    chmod 0664 /dev/cpuset/tasks

    # each cluster min/max interface
    chown root system /sys/devices/system/cpu/cpufreq/policy0/user_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy0/user_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/user_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/user_max_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy4/user_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy4/user_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/user_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/user_max_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy7/user_min_freq
    chown root system /sys/devices/system/cpu/cpufreq/policy7/user_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/user_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/user_max_freq

    # Apply network parameters for high data performance.
    write /proc/sys/net/core/rmem_default 4194304
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/wmem_default 2097152
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/core/optmem_max 20480
    write /proc/sys/net/core/netdev_max_backlog 100000
    write /proc/sys/net/ipv4/tcp_rmem "2097152 4194304 8388608"
    write /proc/sys/net/ipv4/tcp_wmem "2097152 4194304 8388608"
    write /proc/sys/net/ipv4/tcp_mem "44259 59012 88518"
    write /proc/sys/net/ipv4/udp_mem "88518 118025 177036"
    write /proc/sys/net/ipv4/tcp_adv_win_scale "2"
    write /sys/module/tcp_cubic/parameters/hystart_detect "0"

    # for chub dev
    chmod 0664 /dev/nanohub
    chmod 0664 /dev/nanohub_comms
    chmod 0664 /dev/chub_dev
    chown system system /dev/nanohub
    chown system system /dev/nanohub_comms
    chown system system /dev/chub_dev

    chown system system /sys/devices/platform/hts/conf/group_mask
    chown system system /sys/devices/platform/hts/conf/cgroup
    chown system system /sys/devices/platform/hts/conf/enable_mask
    chown system system /sys/devices/platform/hts/conf/ref_mask
    chown system system /sys/devices/platform/hts/conf/def_mask
    write /sys/devices/platform/hts/conf/group_mask 0-3
    write /sys/devices/platform/hts/conf/group_mask 4-6
    write /sys/devices/platform/hts/conf/group_mask 7
    write /sys/devices/platform/hts/conf/cgroup "/top-app"
    write /sys/devices/platform/hts/conf/enable_mask "0 0 1"
    write /sys/devices/platform/hts/conf/enable_mask "0 1 0"
    write /sys/devices/platform/hts/conf/enable_mask "1 0 1"
    write /sys/devices/platform/hts/conf/enable_mask "1 1 1"
    write /sys/devices/platform/hts/conf/enable_mask "2 0 1"
    write /sys/devices/platform/hts/conf/enable_mask "2 1 1"
    write /sys/devices/platform/hts/conf/ref_mask 4-6
    write /sys/devices/platform/hts/enable 1

on post-fs-data
# Log data folder
    mkdir /data/vendor 0771 root system
    mkdir /data/vendor/log 0771 root system
    mkdir /data/vendor/log/abox 0771 audioserver system
    mkdir /data/vendor/log/cbd 0771 root system
    mkdir /data/vendor/log/chub 0771 root system
    mkdir /data/vendor/log/vts 0771 audioserver system
# IPSEC PIDDIR for VoWiFi
    mkdir /data/vendor/misc 0771 root system
    mkdir /data/vendor/misc/vpn 0771 radio system

    setprop vold.post_fs_data_done 1
    setprop sys.usb.controller 13200000.dwc3

## SCSC WLAN
    # Setup Wi-Fi permissions
    mkdir /data/vendor/wifi 0770 wifi system
    mkdir /data/vendor/wifi/wpa 0770 wifi system
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi
    mkdir /vendor/etc/wifi 0770 system system
    mkdir /data/vendor/log/wifi 0770 wifi wifi
    mkdir /data/vendor/conn 0770 wifi wifi
    mkdir /data/vendor/wlbt 0770 wifi wifi
    chown wifi wifi /sys/wifi/memdump
    chown wifi wifi /sys/wifi/feature

# permissions for bluetooth.
    setprop ro.bt.bdaddr_path "/mnt/vendor/efs/bluetooth/bt_addr"
    chown bluetooth bluetooth ro.bt.bdaddr_path

# for BT MAC address
    mkdir /mnt/vendor/efs/bluetooth 0770 system bluetooth
# if already exist
    chown system bluetooth /mnt/vendor/efs/bluetooth
    chown system bluetooth /mnt/vendor/efs/bluetooth/bt_addr
    chmod 0770 /mnt/vendor/efs/bluetooth
    chmod 0660 /mnt/vendor/efs/bluetooth/bt_addr

# Gnss data
    mkdir /data/vendor/gps 0771 system system
    mkdir /data/vendor/log/gps 0771 system system
    rm /data/vendor/gps/gps_started
    rm /data/vendor/gps/glonass_started
    rm /data/vendor/gps/beidou_started
    rm /data/vendor/gps/smd_started
    rm /data/vendor/gps/sv_cno.info

# Permissions Camera
    mkdir /data/vendor/camera 0777 root root

    chmod 0755 /sys/kernel/debug/tracing
    restorecon /sys/kernel/debug/tracing/trace_marker

# Gatekeeper data
    mkdir /data/vendor/gk 0771 system system
    mkdir /mnt/vendor/persist/gk 0700 system system

# Weaver data
    mkdir /mnt/vendor/persist/weaver 0700 system system
    mkdir /data/vendor/weaver 0700 system system

# Video data
    mkdir /data/vendor/media 0700 mediacodec mediacodec
    mkdir /data/vendor/media/gpu 0700 mediacodec mediacodec

# Permission for GPU
    chown mediacodec system /sys/kernel/gpu/gpu_mm_min_clock
    chmod 0644 /sys/kernel/gpu/gpu_mm_min_clock
    chmod 0000 /sys/class/devfreq/16e00000.sgpu/trans_stat

# HWC data
    mkdir /data/vendor/log/hwc 0771 system graphics

# WFD data
    mkdir /data/vendor/log/wfd 0771 system graphics

# Eden data
    mkdir /data/vendor/eden 0771 system system
    mkdir /data/vendor/eden/gpu 0771 system system

# ENN data
    mkdir /data/vendor/enn 0771 system system

on early-boot
    # Update dm-verity state and set partition.*.verified properties
    verity_update_state

on boot
    setprop wifi.interface wlan0

    # SCSC do not enable autorecovery in dev builds
    #write /sys/module/scsc_mx/parameters/disable_recovery_handling 0
    #settings put global captive_portal_mode 0

    # Allow to access debugfs for system:system
    chmod 0755 /sys/kernel/debug
    chown system system /sys/kernel/debug

    setprop ro.radio.noril no

    # Set up kernel tracing, but disable it by default
    chmod 0222 /sys/kernel/debug/tracing/trace_marker
    write /sys/kernel/debug/tracing/tracing_on 0

    # Change permission for A-Box firmware logs file & GPR dump
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/gicd
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/gpr
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/calliope_sram
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/calliope_dram
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/calliope_log
    chown audioserver system /sys/devices/platform/14e50000.abox/0.abox-debug/calliope_slog
    chown audioserver system /sys/kernel/debug/regmap/14e50000.abox/registers
    chown audioserver system /proc/abox/log-00
    chown audioserver system /proc/abox/log-01
    chown audioserver system /proc/abox/qos
    chown audioserver system /proc/abox/failsafe/online
    chown audioserver system /proc/abox/failsafe/reset
    chown audioserver system /proc/abox/oem/noise

# Permission for USB SELECT
    chown system system /sys/class/android_usb/android0/enable
    chmod 0660 /sys/class/android_usb/android0/enable
    chown system system /sys/class/android_usb/android0/idVendor
    chmod 0660 /sys/class/android_usb/android0/idVendor
    chown system system /sys/class/android_usb/android0/idProduct
    chmod 0660 /sys/class/android_usb/android0/idProduct
    chown system system /sys/class/android_usb/android0/f_diag/clients
    chmod 0660 /sys/class/android_usb/android0/f_diag/clients
    chown system system /sys/class/android_usb/android0/functions
    chmod 0660 /sys/class/android_usb/android0/functions
    chown system system /sys/class/android_usb/android0/bDeviceClass
    chmod 0660 /sys/class/android_usb/android0/bDeviceClass

# Permission for UART SWITCH
    chmod 0660 /sys/class/sec/switch/uart_sel
    chown system system /sys/class/sec/switch/uart_sel

# Permission for GPU
    chown mediacodec system /sys/kernel/gpu/gpu_mm_min_clock
    chmod 0664 /sys/kernel/gpu/gpu_mm_min_clock

# Permissions for ds_detect
    chmod 0660 /sys/devices/platform/cpif/sim/ds_detect
    chown system system /sys/devices/platform/cpif/sim/ds_detect

on early-fs
#    write /sys/devices/platform/fmp/fmp-fips/fmp_fips_run 1

on late-fs
    wait_for_prop vendor.vendor_dlkm.modules.ready true
#    wait_for_prop vendor.sys.mobicoredaemon.enable true
    mount_all /vendor/etc/fstab.${ro.boot.fstab_suffix} --late
    swapon_all /vendor/etc/fstab.${ro.boot.fstab_suffix}

on fs
    mount_all /vendor/etc/fstab.${ro.boot.fstab_suffix} --early

    wait /dev/block/by-name/sec_efs
    mount ext4 /dev/block/by-name/sec_efs /efs nosuid nodev noatime noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic

    setprop ro.crypto.fuse_sdcard true

    restorecon_recursive /mnt/vendor/efs
    restorecon_recursive /mnt/vendor/cpefs
    restorecon_recursive /mnt/vendor/persist

    chown radio system /mnt/vendor/efs
    chmod 0771 /mnt/vendor/efs
    chown radio system /mnt/vendor/cpefs
    chmod 0771 /mnt/vendor/cpefs
    chown radio system /mnt/vendor/persist

    mkdir /mnt/vendor/persist/data/sfs 0700 system system
    mkdir /mnt/vendor/persist/data/tz 0700 system system

## SCSC WLAN
    # WLBT FW flash update
    write /sys/module/scsc_flash_service/parameters/flash_srv_manual 1

# modem partition for cbd
#    setprop vendor.cbd.partition modem
#    setprop persist.vendor.cbd.btl_size 64

# Permissions for ION
    chmod 0660 /sys/class/ion_cma/ion_video_ext/isolated
    chown system system /sys/class/ion_cma/ion_video_ext/isolated

# Permissions for backlight
    chown system system /sys/class/backlight/panel/brightness

# Permissions for LCD
    chown system system /dev/sec_display_debug
    chown system radio /sys/class/lcd/panel/manufacture_code
    chown system radio /sys/class/lcd/panel/lcd_type
    chown system system /sys/class/lcd/panel/siop_enable
    chown system system /sys/class/lcd/panel/temperature
    chown system radio /sys/class/lcd/panel/mcd_mode
    chown system system /sys/class/lcd/panel/lux
    chown system media_rw /sys/class/lcd/panel/adaptive_control
    chown system system /sys/class/lcd/panel/SVC_OCTA
    chown system system /sys/class/lcd/panel/SVC_OCTA_DDI_CHIPID
    chown system system /sys/class/lcd/panel/self_mask_check
    chown system radio /sys/class/lcd/panel/conn_det
    chown system system /sys/class/lcd/panel/vrr
    chown system system /sys/class/lcd/panel/alpm
    chown system system /sys/class/lcd/panel/dpci
    chown system system /sys/class/lcd/panel/dpci_dbg
    chown system system /sys/class/lcd/panel/dpui
    chown system system /sys/class/lcd/panel/dpui_dbg
    chown system system /sys/class/lcd/panel/mask_brightness
    chown system system /sys/class/lcd/panel/actual_mask_brightness
    chown system system /sys/class/lcd/panel/dsc_crc
    chown system system /sys/class/lcd/panel/gct
    chown system system /sys/class/lcd/panel/ecc
    chown system system /sys/class/lcd/panel/ccd_state
    chown system system /sys/class/lcd/panel/irc_mode
    chown system system /sys/class/lcd/panel/display_on

    chmod 0666 /sys/module/exynos_drm/parameters/dpu_event_log
    chown system graphics /sys/module/exynos_drm/parameters/dpu_event_log

# Permissions for MDNIE
    chown system media_rw /sys/class/mdnie/mdnie/mode
    chown system media_rw /sys/class/mdnie/mdnie/scenario
    chown system system /sys/class/mdnie/mdnie/accessibility
    chown system system /sys/class/mdnie/mdnie/sensorRGB
    chown system system /sys/class/mdnie/mdnie/whiteRGB
    chown system system /sys/class/mdnie/mdnie/night_mode
    chown system system /sys/class/mdnie/mdnie/light_notification
    chown system system /sys/class/mdnie/mdnie/color_lens
    chown system system /sys/class/mdnie/mdnie/bypass
    chown system system /sys/class/mdnie/mdnie/mdnie_ldu
    chown system system /sys/class/mdnie/mdnie/hdr
    chown system system /sys/class/mdnie/mdnie/anti_glare
    chown system system /sys/class/mdnie/mdnie/extra_dim
    chown system system /sys/class/mdnie/mdnie/vividness

# Permissions for drm/kms
    chmod 0666 /dev/dri/card0
    chown system graphics /dev/dri/card0
    chmod 0666 /dev/dri/card1
    chown system graphics /dev/dri/card1

# Permissions for idle timer
    chmod 0660 /sys/devices/platform/168c0000.drmdsim/168c0000.drmdsim.0/panel_idle_timer_ms
    chown system graphics /sys/devices/platform/168c0000.drmdsim/168c0000.drmdsim.0/panel_idle_timer_ms

# Permissions for dqe
    chmod 0660 /sys/class/dqe/dqe/mode_idx
    chown system system /sys/class/dqe/dqe/mode_idx
    chmod 0660 /sys/class/dqe/dqe/gamma_ext
    chown system system /sys/class/dqe/dqe/gamma_ext
    chmod 0660 /sys/class/dqe/dqe/gamma
    chown system system /sys/class/dqe/dqe/gamma
    chmod 0660 /sys/class/dqe/dqe/aps
    chown system system /sys/class/dqe/dqe/aps
    chmod 0660 /sys/class/dqe/dqe/aps_onoff
    chown system system /sys/class/dqe/dqe/aps_onoff
    chmod 0660 /sys/class/dqe/dqe/aps_lux
    chown system system /sys/class/dqe/dqe/aps_lux
    chmod 0660 /sys/class/dqe/dqe/cgc17_idx
    chown system system /sys/class/dqe/dqe/cgc17_idx
    chmod 0660 /sys/class/dqe/dqe/cgc17_enc
    chown system system /sys/class/dqe/dqe/cgc17_enc
    chmod 0660 /sys/class/dqe/dqe/cgc17_dec
    chown system system /sys/class/dqe/dqe/cgc17_dec
    chmod 0660 /sys/class/dqe/dqe/cgc17_con
    chown system system /sys/class/dqe/dqe/cgc17_con
    chmod 0660 /sys/class/dqe/dqe/hsc48_idx
    chown system system /sys/class/dqe/dqe/hsc48_idx
    chmod 0660 /sys/class/dqe/dqe/hsc48_lcg
    chown system system /sys/class/dqe/dqe/hsc48_lcg
    chmod 0660 /sys/class/dqe/dqe/hsc
    chown system system /sys/class/dqe/dqe/hsc
    chmod 0660 /sys/class/dqe/dqe/scl
    chown system system /sys/class/dqe/dqe/scl
    chmod 0660 /sys/class/dqe/dqe/degamma_ext
    chown system system /sys/class/dqe/dqe/degamma_ext
    chmod 0660 /sys/class/dqe/dqe/degamma
    chown system system /sys/class/dqe/dqe/degamma
    chmod 0660 /sys/class/dqe/dqe/linear_matrix
    chown system system /sys/class/dqe/dqe/linear_matrix
    chmod 0660 /sys/class/dqe/dqe/gamma_matrix
    chown system system /sys/class/dqe/dqe/gamma_matrix
    chmod 0440 /sys/class/dqe/dqe/xml
    chown system system /sys/class/dqe/dqe/xml
    chmod 0440 /sys/class/dqe/dqe/dqe_ver
    chown system system /sys/class/dqe/dqe/dqe_ver
    chmod 0660 /sys/class/dqe/dqe/disp_dither
    chown system system /sys/class/dqe/dqe/disp_dither
    chmod 0660 /sys/class/dqe/dqe/cgc_dither
    chown system system /sys/class/dqe/dqe/cgc_dither
    chmod 0660 /sys/class/dqe/dqe/color_mode
    chown system system /sys/class/dqe/dqe/color_mode
    chmod 0440 /sys/class/dqe/dqe/dim_status
    chown system system /sys/class/dqe/dqe/dim_status
    chmod 0660 /sys/class/dqe/dqe/de
    chown system system /sys/class/dqe/dqe/de

# Copy DRM Key
#    copy /system/app/wv.keys /factory/wv.keys

# Permission for DRM Key
#    chmod 0644 /factory/wv.keys

# Permision for xlat control
    chmod 0660 /sys/kernel/clat/xlat_plat
    chown clat clat /sys/kernel/clat/xlat_plat
    chmod 0660 /sys/kernel/clat/xlat_addrs
    chown clat clat /sys/kernel/clat/xlat_addrs
    chmod 0660 /sys/kernel/clat/xlat_v4_addrs
    chown clat clat /sys/kernel/clat/xlat_v4_addrs

# Permission for flashlight control for HAL3.3
# The Istor espresso board does not have the flash led h/w, So the below permission line are blocked.
# If you want to test the flashlight in board which have the flash led h/w, Enable the below blocked lines.
    chmod 0660 /sys/class/camera/flash/rear_flash
    chown system camera /sys/class/camera/flash/rear_flash

#load ecd firmware
    write /proc/ecd/load_firmware 1

service fuse_sdcard /system/bin/sdcard -u 1023 -g 1023 -d /mnt/media_rw/sdcard /storage/sdcard
    class late_start
    disabled
service fuse_usb1 /system/bin/sdcard -u 1023 -g 1023 -d /mnt/media_rw/usb1 /storage/usb1
    class late_start
    disabled
service fuse_usb2 /system/bin/sdcard -u 1023 -g 1023 -d /mnt/media_rw/usb2 /storage/usb2
    class late_start
    disabled

# Write build info to kdebuginfo
on property:ro.build.fingerprint=*
    write /sys/module/debug_kinfo/parameters/build_info ${ro.build.fingerprint}

# Set watchdog timer to 30 seconds and fed it every 10 seconds to get a 20 second margin
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    oneshot
    seclabel u:r:watchdogd:s0

# CP boot daemon
#service cpboot-daemon /vendor/bin/cbd -d -t modap_sit -P by-name/${vendor.cbd.partition} -o s -o c -s 2
#    class main
#    user root
#    group radio cache inet misc audio sdcard_rw log system
#    seclabel u:r:cbd:s0

#on property:ro.boot.slot_suffix=*
#    setprop vendor.cbd.partition modem${ro.boot.slot_suffix}

# on userdebug and eng builds, enable kgdb on the serial console
on property:ro.debuggable=1
    write /sys/module/kgdboc/parameters/kgdboc ttyFIQ1
    write /sys/module/fiq_debugger/parameters/kgdb_enable 1

# IMS WiFi Calling [START] #
service charonservice /system/vendor/bin/charon
        class main
        user root
        group system
        disabled
        seclabel u:r:charonservice:s0

on property:vendor.charon.exec=1
    rm /data/vendor/misc/vpn/charon.pid
    chmod 0666 /dev/tun
    start charonservice

on property:vendor.charon.exec=0
    stop charonservice
    rm /data/vendor/misc/vpn/charon.pid
# IMS WiFi Calling [END] #

# IMS packet router daemon
service pktrouter /system/vendor/bin/wfc-pkt-router
    class main
    user root
    group system radio
    disabled
    seclabel u:r:pktrouter:s0

on property:vendor.pktrouter=1
    start pktrouter

on property:vendor.pktrouter=0
    stop pktrouter

service insmod_sh_common /vendor/bin/init.insmod.sh vendor_dlkm
    class main
    user root
    group root system
    disabled
    oneshot

service insmod_sh_system /vendor/bin/init.insmod.sh system_dlkm
    class main
    user root
    group root system
    disabled
    oneshot

# sched_pelt_multiplier for vendor
on property:vendor.sched_pelt_multiplier=*
    write /proc/sys/kernel/sched_pelt_multiplier ${vendor.sched_pelt_multiplier}

## SCSC WLAN
# WiFi wpa suppplicant service is defined due to WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY in BoardConfig.mk

service dhcpcd_wlan0 /vendor/bin/dhcpcd -aABDKL
        class main
        disabled
        oneshot

service iprenew_wlan0 /vendor/bin/dhcpcd -n
        class main
        disabled
        oneshot

service dhcpcd_p2p /vendor/bin/dhcpcd -aABKL
        class main
        disabled
        oneshot

service iprenew_p2p /vendor/bin/dhcpcd -n
        class main
        disabled
        oneshot

## SLSI Bluetooth
service insmod_sh_bluetooth /vendor/bin/init.insmod.sh /vendor/etc/init.insmod.bluetooth.cfg
    class main
    user root
    group root system
    disabled
    oneshot

## Bluetooth HTF convertor
on property:vendor.system_dlkm.modules.ready=true
    chown bluetooth bluetooth /sys/module/scsc_bt/parameters/bluetooth_address
    start bluetooth_configcmd_sh

## SLSI Bluetooth
service bluetooth_configcmd_sh /vendor/bin/configcmd.sh
    class main
    user wifi
    group wifi log
    disabled
    oneshot

# Pageboostd
on property:sys.boot_completed=1
    start pageboostd

service pageboostd /system/bin/pageboostd
    class main
    user system
    group system mount radio net_bt sdcard_rw shell media media_rw
    socket pageboostd seqpacket 0660 system system
    disabled
